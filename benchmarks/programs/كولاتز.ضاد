# حدسية كولاتز: أطول مسار لأعداد حتى ٣٠٠٠٠ — حلقة «طالما» وتفرع
دالة طول_المسار(ن) {
    دع خطوات = ٠
    طالما ن != ١ {
        إذا ن % ٢ == ٠ {
            ن = ن // ٢
        } وإلا {
            ن = ٣ * ن + ١
        }
        خطوات = خطوات + ١
    }
    أرجع خطوات
}
دع الأطول = ٠
دع صاحبه = ١
لكل ع في ١..٣٠٠٠٠ {
    دع ط = طول_المسار(ع)
    إذا ط > الأطول {
        الأطول = ط
        صاحبه = ع
    }
}
اطبع("أطول مسار:", الأطول، "للعدد", صاحبه)
