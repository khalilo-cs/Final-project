# مجموع القاسم المشترك الأكبر لكل الأزواج: خوارزمية إقليدس
دالة قمأ(أ، ب) {
    طالما ب != ٠ {
        دع م = أ % ب
        أ = ب
        ب = م
    }
    أرجع أ
}
دع المجموع = ٠
لكل س في ١..٣٠٠ {
    لكل ص في ١..٣٠٠ {
        المجموع = المجموع + قمأ(س، ص)
    }
}
اطبع("مجموع ق.م.أ للأزواج حتى ٣٠٠ =", المجموع)
