# عدّ الأعداد الأولية بالقسمة التجريبية: حلقات متداخلة وباقي القسمة
دالة أولي؟(ع) {
    إذا ع < ٢ { أرجع خطأ }
    لكل ق في ٢..ع {
        إذا ق * ق > ع { توقف }
        إذا ع % ق == ٠ { أرجع خطأ }
    }
    أرجع صحيح
}
دع العدد = ٠
لكل ع في ٠..٢٠٠٠٠ {
    إذا أولي؟(ع) { العدد = العدد + ١ }
}
اطبع("عدد الأعداد الأولية تحت ٢٠٠٠٠ ="، العدد)
