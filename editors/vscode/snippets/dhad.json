{
  "دالة": {
    "prefix": [
      "دالة",
      "dala"
    ],
    "body": [
      "## ${3:وصف الدالة}",
      "دالة ${1:الاسم}(${2:المعاملات}) {",
      "\t$0",
      "}"
    ],
    "description": "تعريف دالة موثقة"
  },
  "إذا": {
    "prefix": [
      "إذا",
      "اذا"
    ],
    "body": [
      "إذا ${1:الشرط} {",
      "\t$0",
      "}"
    ],
    "description": "تفرع شرطي"
  },
  "إذا وإلا": {
    "prefix": [
      "إذاوإلا",
      "ifelse"
    ],
    "body": [
      "إذا ${1:الشرط} {",
      "\t$2",
      "} وإلا {",
      "\t$0",
      "}"
    ],
    "description": "تفرع بفرعين"
  },
  "طالما": {
    "prefix": [
      "طالما"
    ],
    "body": [
      "طالما ${1:الشرط} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة شرطية"
  },
  "لكل": {
    "prefix": [
      "لكل"
    ],
    "body": [
      "لكل ${1:ع} في ${2:١..١٠} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة تكرار"
  },
  "اختبر": {
    "prefix": [
      "اختبر"
    ],
    "body": [
      "اختبر \"${1:الوصف}\" {",
      "\tتأكد($0)",
      "}"
    ],
    "description": "كتلة اختبار"
  },
  "قاموس": {
    "prefix": [
      "قاموس"
    ],
    "body": [
      "دع ${1:الاسم} = {",
      "\t\"${2:مفتاح}\": ${3:قيمة}$0",
      "}"
    ],
    "description": "قاموس"
  }
}