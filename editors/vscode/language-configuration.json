{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "«", "close": "»", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["«", "»"]],
  "indentationRules": { "increaseIndentPattern": "\\{[^}\"]*$", "decreaseIndentPattern": "^\\s*\\}" },
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*[؟?]?"
}
