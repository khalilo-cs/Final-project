استورد قوائم
استورد نصوص

دع الدرجات = {"سارة": ٩٥، "أحمد": ٧٨، "ليلى": ٨٨}
دع المجموع = ٠
لكل الطالب في الدرجات {
    دع د = الدرجات[الطالب]
    المجموع = المجموع + د
    إذا د >= ٩٠ {
        اطبع("${الطالب}: ممتاز")
    } وإلا إذا د >= ٨٠ {
        اطبع("${الطالب}: جيد جدًا")
    } وإلا {
        اطبع("${الطالب}: جيد")
    }
}
اطبع("المتوسط:", المجموع / طول(الدرجات))

دع أرقام = [٥، ٣، ٩، ١، ٧]
اطبع("مرتبة:", قوائم.رتّب(أرقام))
اطبع("المجموع:", قوائم.اجمع(أرقام), "— الأكبر:", أكبر(أرقام))

دع جملة = "البرمجة بالعربية ممتعة جدًا"
دع الكلمات = نصوص.قسّم(جملة)
اطبع("عدد الكلمات:", طول(الكلمات))
اطبع(نصوص.اربط(قوائم.اعكس(الكلمات)، " ← "))
اطبع(نصوص.احذف_التشكيل("مَرْحَبًا بِكُمْ"))
