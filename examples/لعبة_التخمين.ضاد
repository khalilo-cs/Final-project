استورد عشوائي

دع السر = عشوائي.عدد_عشوائي(١، ١٠٠)
دع المحاولات = ٠
اطبع("فكّرت في عدد بين ١ و ١٠٠. حاول تخمينه!")
طالما صحيح {
    دع النص = اقرأ("تخمينك: ")
    إذا النص == "" { توقف }
    دع التخمين = عدد(النص)
    المحاولات = المحاولات + ١
    إذا التخمين < السر {
        اطبع("أكبر ↑")
    } وإلا إذا التخمين > السر {
        اطبع("أصغر ↓")
    } وإلا {
        اطبع("أحسنت! وجدته في ${المحاولات} محاولة.")
        توقف
    }
}
