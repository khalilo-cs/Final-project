استورد رياضيات

دالة مضروب(ن) {
    إذا ن <= ١ {
        أرجع ١
    }
    أرجع ن * مضروب(ن - ١)
}

دالة أولي؟(ع) {
    إذا ع < ٢ { أرجع خطأ }
    لكل ق في ٢..ع {
        إذا ق * ق > ع { توقف }
        إذا ع % ق == ٠ { أرجع خطأ }
    }
    أرجع صحيح
}

دع الأعداد = [١، ٢، ٣، ٤، ٥، ٦، ٧]
لكل ع في الأعداد {
    إذا أولي؟(ع) {
        اطبع("${ع} عدد أولي ومضروبه ${مضروب(ع)}")
    }
}

