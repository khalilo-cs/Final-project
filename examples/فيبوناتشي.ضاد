# مقارنة الاستدعاء الذاتي مع الحلقة
دالة فيب_ذاتي(ن) {
    إذا ن < ٢ { أرجع ن }
    أرجع فيب_ذاتي(ن - ١) + فيب_ذاتي(ن - ٢)
}

دالة فيب_حلقة(ن) {
    دع أ = ٠
    دع ب = ١
    لكل _ في ٠..ن {
        دع مؤقت = أ + ب
        أ = ب
        ب = مؤقت
    }
    أرجع أ
}

اطبع("فيب(٢٠) ذاتيًا =", فيب_ذاتي(٢٠))
اطبع("فيب(٩٠) بالحلقة =", فيب_حلقة(٩٠))

اختبر "الطريقتان متطابقتان" {
    لكل ن في ٠..١٥ {
        تأكد(فيب_ذاتي(ن) == فيب_حلقة(ن))
    }
}
اختبر "قيم معروفة" {
    تأكد(فيب_حلقة(١٠) == ٥٥، "فيب(١٠) يجب أن يساوي ٥٥")
}
