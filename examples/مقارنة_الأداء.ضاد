# شغّله بـ «▶ تشغيل» ثم بـ «⚡ ترجم وشغّل» وقارن الزمن في شريط الحالة.
دالة فيب(ن) {
    إذا ن < ٢ { أرجع ن }
    أرجع فيب(ن - ١) + فيب(ن - ٢)
}

دالة أولي؟(ع) {
    إذا ع < ٢ { أرجع خطأ }
    لكل ق في ٢..ع {
        إذا ق * ق > ع { توقف }
        إذا ع % ق == ٠ { أرجع خطأ }
    }
    أرجع صحيح
}

دع العدد = ٠
لكل ع في ٠..٥٠٠٠ {
    إذا أولي؟(ع) { العدد = العدد + ١ }
}
اطبع("فيب(٢٢) =", فيب(٢٢))
اطبع("الأعداد الأولية تحت ٥٠٠٠:", العدد)
