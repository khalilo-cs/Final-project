دالة صانع_عداد() {
    دع ع = ٠
    دالة زد() {
        ع = ع + ١
        أرجع ع
    }
    أرجع زد
}
دع عداد = صانع_عداد()
عداد()
عداد()
اطبع("العداد:"، عداد())

دالة طبّق(د، قائمة) {
    دع ناتج = []
    لكل ع في قائمة { أضف(ناتج، د(ع)) }
    أرجع ناتج
}
دالة مربع(س) { أرجع س * س }
اطبع(طبّق(مربع، [١، ٢، ٣، ٤]))

دالة بلا_إرجاع() { دع ت = ١ }
اطبع(بلا_إرجاع())

دالة هانوي(ن، من، إلى، عبر) {
    إذا ن == ٠ { أرجع ٠ }
    أرجع هانوي(ن - ١، من، عبر، إلى) + ١ + هانوي(ن - ١، عبر، إلى، من)
}
اطبع("نقلات هانوي لـ ١٠ أقراص:"، هانوي(١٠، "أ"، "ج"، "ب"))
