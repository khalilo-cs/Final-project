دالة صنّف(د) {
    إذا د >= ٩٠ {
        أرجع "ممتاز"
    } وإلا إذا د >= ٧٥ {
        أرجع "جيد جدًا"
    } وإلا إذا د >= ٦٠ {
        أرجع "مقبول"
    } وإلا {
        أرجع "راسب"
    }
}
لكل د في [٩٥، ٨٠، ٦٠، ٣٠] {
    اطبع(د، صنّف(د))
}
اطبع(صحيح و خطأ، صحيح أو خطأ، ليس خطأ)
اطبع(١ < ٢ و ٢ < ٣، "أ" < "ب"، ١ == ١٫٠، [١، ٢] == [١، ٢])
اطبع(خطأ و (١ / ٠ == ٠))
