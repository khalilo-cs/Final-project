# الحل المرجعي لمهمة الإصلاح (للباحث فقط)
دع الدرجات = [٧٠، ٩٥، ٥٥، ٨٠، ١٠٠]
دع الأكبر = الدرجات[٠]                         # ١) كانت «الاكبر» بلا همزة (ضاد-1001)
دع المجموع = ٠
دع الناجحون = ٠
لكل د في الدرجات {
    إذا د > الأكبر { الأكبر = د }
    المجموع = المجموع + د
    إذا د >= ٦٠ { الناجحون = الناجحون + ١ }  # ٢) كان «إذا د» — الشرط ليس منطقيًا (ضاد-1010)
}
اطبع("أكبر درجة: " + نص(الأكبر))             # ٣) لا يُجمع نص مع عدد (ضاد-1003)
اطبع("المتوسط:"، المجموع // طول(الدرجات))     # ٤) كانت «درجات» (ضاد-1001)
اطبع("عدد الناجحين:"، الناجحون)               # ٥) كانت «الناجحين» (ضاد-1001)
