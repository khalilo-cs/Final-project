# Copy to .env and fill in real values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

POSTGRES_USER=aipe
POSTGRES_PASSWORD=
POSTGRES_DB=aipe

# First admin account, created on first start of auth-service.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Only needed with `--profile infra`
RABBITMQ_USER=aipe
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=aipe
MINIO_ROOT_PASSWORD=

# -- AI models for the viva (all optional; the built-in engine always works) ----------
# Local model via Ollama (docker compose --profile ai up -d): http://ollama:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
# Claude (Anthropic API)
CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
# Any OpenAI-compatible server (vLLM, LM Studio, llama.cpp server, ...)
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# -- E-mail copies of notifications (optional; in-app notifications always work) ------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Project Examiner <no-reply@example.edu>
PUBLIC_URL=http://localhost:8080

# -- Speech-to-text for spoken viva answers --------------------------------------------
# local: Whisper on this server (private). remote: any OpenAI-compatible transcription
# server (SPEECH_REMOTE_URL). off: the browser's own recognition is used instead.
SPEECH_BACKEND=local
WHISPER_MODEL=small
SPEECH_REMOTE_URL=
SPEECH_REMOTE_API_KEY=

# -- Sign in with the university's accounts (OpenID Connect; optional) ----------------
# Register the app with the university's identity provider (Microsoft Entra ID,
# Google Workspace, Keycloak, ...) with redirect URI:
#   ${PUBLIC_URL}/svc/auth/api/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# JSON lists. Only these e-mail domains may sign in, e.g. ["su.edu.ye"]
OIDC_ALLOWED_DOMAINS=[]
# New accounts are students unless OIDC_ROLE_CLAIM (e.g. roles / groups) contains a
# faculty value, e.g. ["Faculty"]. Admin rights are never granted through SSO.
OIDC_ROLE_CLAIM=
OIDC_FACULTY_VALUES=[]
