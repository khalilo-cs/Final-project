# Copy to .env and fill in real values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

POSTGRES_USER=aipe
POSTGRES_PASSWORD=
POSTGRES_DB=aipe

# First admin account, created on first start of auth-service.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Only needed with `--profile infra`
RABBITMQ_USER=aipe
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=aipe
MINIO_ROOT_PASSWORD=
